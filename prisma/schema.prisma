generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  COACH
  ANALYST
  PARENT // parent/guardian login (one login per guardian)
  PLAYER
  SAFEGUARDING_LEAD // NEW: Designated Safeguarding Lead (and named deputy)
  MEDICAL_OFFICER // NEW: full access to player health records
}

enum Sex {
  MALE
  FEMALE
}

enum RegistrationStatus {
  PENDING
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum EventType {
  TRAINING
  MATCH
  DRILL
  OTHER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT_EXCUSED
  ABSENT_UNEXCUSED
  INJURED
}

enum AssessmentDomain {
  TECHNICAL
  TACTICAL
  PHYSICAL
  MENTAL
}

// ─────────────────────────────────────────────────────────────
// Users, players, coaches, teams
// ─────────────────────────────────────────────────────────────

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                Role                 @default(PLAYER)
  createdAt           DateTime             @default(now())
  player              Player?
  coach               Coach?
  parentGuardian      ParentGuardian? // set when role = PARENT
  emailNotifications  Boolean              @default(true)
  pushNotifications   Boolean              @default(false)
  pushSubscriptions   PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  staffClearances     StaffClearance[] // NEW: vetting and training records
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Player {
  id String @id @default(cuid())

  // Name lives on Player itself so a player without a login
  // (registered by a parent/guardian) still has a permanent name.
  // Nullable until backfilled from user.name for existing rows.
  name String?

  // Optional — parent-registered players have no login of their own.
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @unique

  // Ongoing parent/guardian relationship (the registration record
  // is only the onboarding/audit trail, not the access-control link).
  parentGuardian   ParentGuardian? @relation(fields: [parentGuardianId], references: [id])
  parentGuardianId String?

  dateOfBirth DateTime?
  sex         Sex? // required for benchmark scoring (nullable until backfilled)
  position    String?
  shirtNumber Int?
  photoUrl    String?
  bio         String?

  team   Team?   @relation(fields: [teamId], references: [id])
  teamId String?

  stats              PlayerStat[]
  progressNotes      ProgressNote[]
  trainingAttendance TrainingAttendance[]
  assessments        DevelopmentAssessment[]
  physicalTests      PhysicalTest[]
  matchPerformances  MatchPerformance[]
  injuryRecords      InjuryRecord[]
  videos             Video[]
  galleryPhotos      GalleryPhoto[] // NEW: photos this player appears in

  // NEW: privacy, health and safeguarding
  consents             PlayerConsent[]
  healthProfile        PlayerHealthProfile?
  emergencyContacts    EmergencyContact[]
  safeguardingConcerns SafeguardingConcern[]
}

model Coach {
  id       String  @id @default(cuid())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String  @unique
  title    String?
  bio      String?
  photoUrl String?

  teams Team[]
}

model Team {
  id        String          @id @default(cuid())
  name      String
  ageGroup  String
  crestUrl  String?
  players   Player[]
  coaches   Coach[]
  schedules ScheduleEvent[]
  videos    Video[]
  photos    GalleryPhoto[]
}

// ─────────────────────────────────────────────────────────────
// Registration, guardians, consent
// ─────────────────────────────────────────────────────────────

model ParentGuardian {
  id String @id @default(cuid())

  // Set once a registration is approved and a PARENT login is created.
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @unique

  firstName    String
  lastName     String
  relationship String
  phone        String
  email        String
  address      String?

  // CHANGED: sensitive. Only collect if you have a stated purpose (e.g. verifying
  // who collects a child). Encrypt at application level, restrict who can read
  // it, and never show it in lists or the review screen. Otherwise remove.
  idNumber String?

  players       Player[]
  registrations PlayerRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlayerRegistration {
  id String @id @default(cuid())

  parentGuardianId String
  parentGuardian   ParentGuardian @relation(fields: [parentGuardianId], references: [id], onDelete: Cascade)

  // Player information
  firstName       String
  lastName        String
  dateOfBirth     DateTime
  gender          String?
  nationality     String?
  position        String?
  preferredFoot   String?
  previousClub    String?
  previousAcademy String?

  // Emergency / medical
  emergencyName         String?
  emergencyPhone        String?
  emergencyRelationship String? // NEW: copied into EmergencyContact on approval

  // CHANGED: sensitive health data. Encrypt at application level. On approval,
  // move it into PlayerHealthProfile and clear this column so health data lives
  // in one protected place with its own retention rules.
  medicalNotes String?

  status RegistrationStatus @default(PENDING)

  reviewedAt   DateTime?
  reviewedById String?
  reviewNotes  String?

  consent ConsentRecord?

  createdPlayerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([parentGuardianId])
}

/// What the guardian submitted at registration (an evidence snapshot).
/// Ongoing consent state lives in PlayerConsent, which is seeded from this
/// record on approval and changes by appending rows afterwards.
model ConsentRecord {
  id String @id @default(cuid())

  registrationId String             @unique
  registration   PlayerRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Required acknowledgements
  dataProcessing Boolean
  statistics     Boolean

  // NEW: required safeguarding authorisation (not an optional consent)
  emergencyTreatmentAuthorised Boolean @default(false)

  // Optional media
  photography    Boolean
  videoRecording Boolean
  publicMedia    Boolean

  // Football development / sharing
  localScouting     Boolean // local (Kenyan) academies, clubs and scouts
  overseasAcademies Boolean
  overseasClubs     Boolean

  // LEGACY: the original form did not say local or overseas for these two.
  // Treat old ticks as LOCAL ONLY until the parent reconfirms.
  // New registrations write the explicit fields below instead.
  scouts Boolean @default(false)
  agents Boolean @default(false)

  // NEW: explicit local / overseas split for scouts and agents
  localAgents    Boolean @default(false)
  overseasScouts Boolean @default(false)
  overseasAgents Boolean @default(false)

  // NEW: other optional consents
  healthData              Boolean @default(false)
  marketingCommunications Boolean @default(false)

  // Parent declaration
  guardianDeclaration Boolean

  consentVersion String // form version
  policyVersion  String? // NEW: privacy policy version accepted
  consentedAt    DateTime

  // Disclose in the privacy policy and apply a retention period.
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
}

enum ConsentType {
  PHOTOGRAPHY
  VIDEO
  PUBLIC_MEDIA
  SCOUTING_LOCAL // local academies, clubs and scouts
  AGENTS_LOCAL
  SCOUTING_OVERSEAS_ACADEMIES
  SCOUTING_OVERSEAS_CLUBS
  SCOUTING_OVERSEAS_SCOUTS
  SCOUTING_OVERSEAS_AGENTS
  HEALTH_DATA
  MARKETING_COMMUNICATIONS
}

enum ConsentGivenBy {
  GUARDIAN
  PLAYER // once the player is 18 or older
}

enum ConsentSource {
  REGISTRATION
  PARENT_DASHBOARD
  PLAYER_AT_18
  ADMIN_ON_BEHALF // e.g. paper form; record who entered it in recordedById
}

/// Append-only ledger of consent decisions. Never update or delete rows:
/// a change (including a withdrawal) is a new row.
/// Current state = latest row per (playerId, type). Anything not recorded = no consent.
///
/// Seeding from ConsentRecord on approval:
///   localScouting + scouts -> SCOUTING_LOCAL, agents + localAgents -> AGENTS_LOCAL,
///   overseasAcademies / overseasClubs / overseasScouts / overseasAgents -> matching
///   SCOUTING_OVERSEAS_*. Legacy scouts/agents ticks never grant overseas sharing.
///
/// Current state query (Postgres):
///   SELECT DISTINCT ON ("playerId", "type") * FROM "PlayerConsent"
///   ORDER BY "playerId", "type", "createdAt" DESC;
model PlayerConsent {
  id       String @id @default(cuid())
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  type    ConsentType
  granted Boolean

  givenById   String // ParentGuardian id, or Player id when givenByRole = PLAYER
  givenByRole ConsentGivenBy
  source      ConsentSource

  formVersion    String
  policyVersion  String
  consentRecordId String? // registration snapshot this came from, if any
  recordedById   String? // staff user, when source = ADMIN_ON_BEHALF

  createdAt DateTime @default(now())

  @@index([playerId, type, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Website cookie consent evidence (NEW)
// ─────────────────────────────────────────────────────────────

/// Written by /api/consent-log. No names or contact details. visitorId is a
/// random id generated in the browser. Server time is the record of truth.
model CookieConsentLog {
  id            String    @id @default(cuid())
  visitorId     String
  analytics     Boolean
  marketing     Boolean
  externalMedia Boolean
  policyVersion String
  action        String // accept_all | reject_all | custom
  clientTime    DateTime?
  createdAt     DateTime  @default(now())

  @@index([visitorId, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Health records (NEW — sensitive personal data)
// ─────────────────────────────────────────────────────────────

/// Collect only what is needed to keep the player safe at training.
/// Requires HEALTH_DATA consent. Fields marked "encrypted" should be encrypted
/// at application level (e.g. AES-GCM with a key held outside the database).
/// Coaches should see a limited view (allergies, emergency treatment
/// authorisation, emergency contacts), not the full profile.
model PlayerHealthProfile {
  id       String @id @default(cuid())
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String @unique

  allergies   String? // encrypted
  conditions  String? // encrypted
  medications String? // encrypted

  doctorName    String?
  doctorPhone   String?
  insuranceInfo String? // encrypted

  emergencyTreatmentAuthorised Boolean   @default(false)
  authorisedAt                 DateTime?

  updatedAt   DateTime @updatedAt
  updatedById String?
}

model EmergencyContact {
  id           String  @id @default(cuid())
  player       Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId     String
  name         String
  relationship String
  phone        String
  isPrimary    Boolean @default(false)

  @@index([playerId])
}

// ─────────────────────────────────────────────────────────────
// Safeguarding (NEW)
// ─────────────────────────────────────────────────────────────

enum ConcernCategory {
  PHYSICAL
  EMOTIONAL
  SEXUAL
  NEGLECT
  ONLINE
  BULLYING
  CONDUCT_BY_STAFF
  OTHER
}

enum ConcernStatus {
  OPEN
  UNDER_REVIEW
  REFERRED_EXTERNAL // e.g. police or children's services
  CLOSED
}

/// Visible only to SAFEGUARDING_LEAD (and a named deputy). Not visible to
/// parents, coaches or general admins, and never shown in lists, search or
/// dashboards. The legal basis for processing is safeguarding duty, not
/// consent, so a parent cannot withdraw it. Add a retention rule with legal advice.
model SafeguardingConcern {
  id String @id @default(cuid())

  // Restrict: a player with a safeguarding record cannot simply be deleted.
  // Handle erasure requests through the safeguarding lead and a lawyer.
  player   Player? @relation(fields: [playerId], references: [id], onDelete: Restrict)
  playerId String? // may concern a group or the environment

  reportedById String
  category     ConcernCategory
  description  String // encrypted
  status       ConcernStatus   @default(OPEN)
  assignedToId String? // Designated Safeguarding Lead
  outcome      String? // encrypted

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  actions SafeguardingAction[]

  @@index([status, createdAt])
  @@index([playerId])
}

model SafeguardingAction {
  id        String              @id @default(cuid())
  concern   SafeguardingConcern @relation(fields: [concernId], references: [id], onDelete: Cascade)
  concernId String
  actorId   String
  note      String // encrypted
  createdAt DateTime            @default(now())

  @@index([concernId, createdAt])
}

enum ClearanceType {
  CERTIFICATE_OF_GOOD_CONDUCT
  SAFEGUARDING_TRAINING
  FIRST_AID
  COACHING_LICENCE
  CODE_OF_CONDUCT_SIGNED
}

/// Vetting and training for every adult who works with players.
/// Block squad assignment while a required item is missing or expired.
model StaffClearance {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  type         ClearanceType
  issuedAt     DateTime
  expiresAt    DateTime?
  documentRef  String? // storage path, not the document itself
  verifiedById String?
  createdAt    DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Privacy compliance (NEW)
// ─────────────────────────────────────────────────────────────

enum DataRequestType {
  ACCESS
  CORRECTION
  DELETION
  RESTRICTION
  OBJECTION
  WITHDRAW_CONSENT
}

enum DataRequestStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REFUSED // record the reason in notes
}

/// Rights requests from parents/guardians (or players at 18+).
/// Set dueAt from the response time promised in the privacy policy.
model DataSubjectRequest {
  id            String            @id @default(cuid())
  type          DataRequestType
  status        DataRequestStatus @default(RECEIVED)
  playerId      String?
  requestedById String? // ParentGuardian or Player id
  receivedAt    DateTime          @default(now())
  dueAt         DateTime?
  completedAt   DateTime?
  handledById   String?
  notes         String?

  @@index([status, dueAt])
}

enum BreachStatus {
  OPEN
  CONTAINED
  REPORTED
  CLOSED
}

/// Track incidents so the regulator and affected families can be notified
/// within the required time. Do not store the leaked data itself here.
model DataBreachIncident {
  id                 String       @id @default(cuid())
  detectedAt         DateTime
  description        String
  dataTypes          String? // e.g. "contact details, photos"
  affectedCount      Int?
  status             BreachStatus @default(OPEN)
  containedAt        DateTime?
  reportedToOdpcAt   DateTime?
  familiesNotifiedAt DateTime?
  handledById        String?
  createdAt          DateTime     @default(now())

  @@index([status, detectedAt])
}

// ─────────────────────────────────────────────────────────────
// Player stats, notes
// ─────────────────────────────────────────────────────────────

model PlayerStat {
  id            String   @id @default(cuid())
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId      String
  season        String
  matchesPlayed Int      @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  minutesPlayed Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model ProgressNote {
  id         String   @id @default(cuid())
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId   String
  authorName String
  note       String
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Schedule, media, content
// ─────────────────────────────────────────────────────────────

model ScheduleEvent {
  id           String               @id @default(cuid())
  team         Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  type         EventType            @default(TRAINING)
  title        String
  description  String?
  location     String?
  startsAt     DateTime
  endsAt       DateTime?
  opponent     String?
  homeScore    Int?
  awayScore    Int?
  attendance   TrainingAttendance[]
  performances MatchPerformance[]
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  team      Team?    @relation(fields: [teamId], references: [id])
  teamId    String?
  createdAt DateTime @default(now())

  // NEW: only show publicly when every tagged player has PUBLIC_MEDIA consent
  // (and PHOTOGRAPHY). Check this in the API, not just in the UI.
  isPublic Boolean  @default(false)
  players  Player[]
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}

model Video {
  id           String   @id @default(cuid())
  team         Team?    @relation(fields: [teamId], references: [id])
  teamId       String?
  title        String
  description  String?
  url          String
  thumbnailUrl String?
  players      Player[]
  createdAt    DateTime @default(now())

  // NEW: only show publicly when every tagged player has PUBLIC_MEDIA consent
  // (and VIDEO). Check this in the API, not just in the UI.
  isPublic Boolean @default(false)
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  body        String
  coverUrl    String?
  publishedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Training attendance
// ─────────────────────────────────────────────────────────────

model TrainingAttendance {
  id         String           @id @default(cuid())
  event      ScheduleEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  player     Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId   String
  status     AttendanceStatus @default(PRESENT)
  rating     Int?
  note       String?
  recordedBy String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([eventId, playerId])
  @@index([playerId])
}

// ─────────────────────────────────────────────────────────────
// Coach development assessments (Batch 1)
// ─────────────────────────────────────────────────────────────

model DevelopmentAssessment {
  id         String            @id @default(cuid())
  player     Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId   String
  assessedAt DateTime          @default(now())
  assessedBy String?
  summary    String?
  nextGoals  String?
  scores     AssessmentScore[]

  @@index([playerId, assessedAt])
}

model AssessmentScore {
  id           String                @id @default(cuid())
  assessment   DevelopmentAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  domain       AssessmentDomain
  attribute    String
  score        Int

  @@unique([assessmentId, attribute])
}

// ─────────────────────────────────────────────────────────────
// Objective physical testing (Batch 2)
// ─────────────────────────────────────────────────────────────

model PhysicalTest {
  id       String               @id @default(cuid())
  player   Player               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String
  testedAt DateTime             @default(now())
  testedBy String?
  ageGroup String? // age group snapshot at test time (e.g. "U13")
  results  PhysicalTestResult[]

  @@index([playerId, testedAt])
}

model PhysicalTestResult {
  id       String       @id @default(cuid())
  test     PhysicalTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId   String
  metric   String
  testCode String? // stable code, e.g. "10M_SPRINT", "CMJ", "YOYO_IR1"
  value    Float
  unit     String

  score            Float? // 0–100 normalized score (null until a benchmark exists)
  benchmarkVersion String? // which BenchmarkConfig version produced the score

  @@unique([testId, metric])
  @@unique([testId, testCode])
}

// Admin-editable benchmark bands used to score physical tests.
// One row per test + age group + sex + version.
model BenchmarkConfig {
  id            String   @id @default(cuid())
  testCode      String
  ageGroup      String
  sex           Sex
  version       String
  minBenchmark  Float
  maxBenchmark  Float
  lowerIsBetter Boolean
  createdAt     DateTime @default(now())

  @@unique([testCode, ageGroup, sex, version])
}

// ─────────────────────────────────────────────────────────────
// Match performance
// ─────────────────────────────────────────────────────────────

model MatchPerformance {
  id              String        @id @default(cuid())
  event           ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId         String
  player          Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId        String
  minutesPlayed   Int           @default(0)
  goals           Int           @default(0)
  assists         Int           @default(0)
  shots           Int           @default(0)
  shotsOnTarget   Int           @default(0)
  passesAttempted Int           @default(0)
  passesCompleted Int           @default(0)
  keyPasses       Int           @default(0)
  dribbles        Int           @default(0)
  tackles         Int           @default(0)
  interceptions   Int           @default(0)
  recoveries      Int           @default(0)
  turnovers       Int           @default(0)
  foulsCommitted  Int           @default(0)
  yellowCards     Int           @default(0)
  redCards        Int           @default(0)
  recordedBy      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([eventId, playerId])
  @@index([playerId])
}

// ─────────────────────────────────────────────────────────────
// Password Reset
// ─────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Injury Tracking
// ─────────────────────────────────────────────────────────────

enum InjuryStatus {
  ACTIVE
  RECOVERED
}

/// Health data. Encrypt description and treatment at application level and
/// restrict reads to coaches (summary only), MEDICAL_OFFICER and ADMIN.
model InjuryRecord {
  id                 String       @id @default(cuid())
  player             Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId           String
  injuryType         String
  description        String? // encrypted
  treatment          String? // NEW: encrypted
  dateOccurred       DateTime
  expectedReturnDate DateTime?
  actualReturnDate   DateTime?
  status             InjuryStatus @default(ACTIVE)
  recordedBy         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([playerId, status])
}

// ─────────────────────────────────────────────────────────────
// Audit Logs
// ─────────────────────────────────────────────────────────────

/// Log reads as well as writes for health, safeguarding, consent, ID numbers
/// and scouting shares (use action values like HEALTH_VIEW, SAFEGUARDING_VIEW,
/// CONSENT_CHANGE, SCOUTING_SHARE). Store metadata only: never put the
/// sensitive content itself in summary or changes.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  playerId   String? // NEW: lets you answer "who accessed this player's data?"
  reason     String? // NEW: required when viewing safeguarding records
  summary    String?
  changes    Json?
  ip         String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([playerId, createdAt])
}